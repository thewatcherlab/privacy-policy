---
import type { AppInfo } from "../app";

interface Props {
	glyph: AppInfo["glyph"];
}

const { glyph } = Astro.props;
---

<svg class="logo-glyph" viewBox="0 0 40 40" aria-hidden="true">
	{
		glyph === "peel" ? (
			<g class="logo-shape">
				<path d="M10 13a3 3 0 0 1 3-3h14a3 3 0 0 1 3 3v8l-9 9h-8a3 3 0 0 1-3-3Z" fill="currentColor" />
				<path class="logo-fold" d="M30 21h-6a3 3 0 0 0-3 3v6Z" />
			</g>
		) : (
			<g class="logo-shape">
				<circle cx="20" cy="20" r="9" fill="none" stroke="currentColor" stroke-width="3.5" />
				<circle class="logo-fold" cx="20" cy="20" r="3" />
			</g>
		)
	}
</svg>
