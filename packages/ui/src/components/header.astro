---
import LogoGlyph from "./logo-glyph.astro";
import type { AppInfo } from "../app";

interface Props {
	app: AppInfo;
}

const { app } = Astro.props;
---

<header class="site-header">
	<div class="header-bar">
		<a class="logo" href="/" aria-label={`${app.name} support`}>
			<span class="logo-mark"><LogoGlyph glyph={app.glyph} /></span>
			<span class="logo-name">{app.name}</span>
		</a>
		<nav class="header-nav" aria-label="Primary">
			<a class="nav-link" href="/privacy">
				<svg viewBox="0 0 24 24" aria-hidden="true">
					<path
						d="M12 1.6c.3 0 .6.07.9.2l7.1 3c.75.32 1.2 1 1.2 1.82v5.1c0 5.14-3.53 9.5-8.6 10.68a2.7 2.7 0 0 1-1.2 0C6.33 21.22 2.8 16.86 2.8 11.72v-5.1c0-.82.45-1.5 1.2-1.82l7.1-3c.3-.13.6-.2.9-.2Z"
					></path>
					<path d="M8.6 12.1l2.3 2.3 4.6-4.8" fill="none" style="stroke: var(--color-page)" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"></path>
				</svg>
				<span>Privacy</span>
			</a>
			<a class="dl soft" href={`mailto:${app.email}`}>
				<span class="dl-icon" aria-hidden="true">
					<svg viewBox="0 0 24 24" width="22" height="22">
						<path
							fill="currentColor"
							d="M4.5 4.5h15A2.5 2.5 0 0 1 22 7v10a2.5 2.5 0 0 1-2.5 2.5h-15A2.5 2.5 0 0 1 2 17V7a2.5 2.5 0 0 1 2.5-2.5Zm.2 2 6.62 5.3a1.1 1.1 0 0 0 1.36 0l6.62-5.3H4.7Zm15.3 1.43-6.38 5.1a2.6 2.6 0 0 1-3.24 0L4 7.93V17c0 .28.22.5.5.5h15a.5.5 0 0 0 .5-.5V7.93Z"
						></path>
					</svg>
				</span>
				<span class="dl-label">Contact</span>
				<span class="dl-arrow" aria-hidden="true">
					<svg viewBox="0 0 24 24" width="20" height="20">
						<path d="M5 12h13M13 6l6 6-6 6" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"></path>
					</svg>
				</span>
			</a>
		</nav>
	</div>
</header>
