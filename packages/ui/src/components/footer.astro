---
import type { AppInfo } from "../app";

interface Props {
	app: AppInfo;
}

const { app } = Astro.props;
---

<footer class="site-footer">
	<div class="socials">
		<a class="icon-btn" href={`mailto:${app.email}`} aria-label={`Email ${app.name} support`}>
			<svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true">
				<path
					d="M4.5 4.5h15A2.5 2.5 0 0 1 22 7v10a2.5 2.5 0 0 1-2.5 2.5h-15A2.5 2.5 0 0 1 2 17V7a2.5 2.5 0 0 1 2.5-2.5Zm.2 2 6.62 5.3a1.1 1.1 0 0 0 1.36 0l6.62-5.3H4.7Zm15.3 1.43-6.38 5.1a2.6 2.6 0 0 1-3.24 0L4 7.93V17c0 .28.22.5.5.5h15a.5.5 0 0 0 .5-.5V7.93Z"
				></path>
			</svg>
		</a>
	</div>
	<nav class="footer-links" aria-label="More">
		<a href="/">Support</a>
		<a href="/privacy">Privacy</a>
		<a href={`mailto:${app.email}`}>{app.email}</a>
	</nav>
	<div class="wordmark" aria-hidden="true">{app.name}</div>
</footer>
